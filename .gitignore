# --- Large binary simulation + dataset artifacts -------------------------
# Deliberately untracked. These are reproducible outputs or multi-hundred-MB
# binaries; tracking them in plain git would make the repo unusable.
#
# The USD scene is the exception that hurts: isaacsim/scene.usd IS a primary
# artifact, but it is 9 MB of binary USDC that no diff can show. Its tracked,
# human- and agent-readable proxy is docs/scene_contract.yaml -- regenerate
# that with scripts/dump_scene_contract.py after ANY change to the scene.
# If you later want the binary itself versioned, `git lfs track "*.usd"`
# (git-lfs is installed on this machine).
*.usd
*.usda
*.mcap

# Recorded bags. Raw data, backed up separately -- not repo content.
rosbags/

# --- ROS 2 colcon workspace ----------------------------------------------
ros_ws/build/
ros_ws/install/
ros_ws/log/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# Generated by ./run.sh yolo from an extracted bag; regenerate rather than
# commit -- except data.yaml, see the AGPL block at the end of this file.
yolo_dataset/*

# Ultralytics training output, and the pretrained checkpoints it downloads
# into the working directory on first use. Note `runs/*` and not `runs/`:
# git cannot re-include a file whose PARENT DIRECTORY is excluded, so
# excluding the directory itself would make the negations below silently
# do nothing.
runs/*
weights/
*.pt

# Generated figure/CSV delivery, rebuilt by scripts/export_evaluation_csv.py
figure-delivery/

# Extracted samples. These were committed when they were a couple of small
# example frames; a 991-frame run is 324 MB, so they are generated artifacts
# now. Regenerate with ./run.sh extract.
rosbag_samples/
yolo_dataset_old_*/

# --- Published on purpose, for AGPL-3.0 compliance ------------------------
# yolo_detector_node imports Ultralytics, which is AGPL-3.0, so the trained
# model and the configuration that produced it are distributed with the source
# rather than kept back. Everything else above stays ignored.
#
# These patterns MUST come last: the last matching pattern wins, and `*.pt`
# above would otherwise re-exclude the checkpoint. Each level of each path
# needs its own negation, for the parent-directory reason noted above.
!runs/sfp_yolo26s_p2/
runs/sfp_yolo26s_p2/*
!runs/sfp_yolo26s_p2/args.yaml
!runs/sfp_yolo26s_p2/results.csv
!runs/sfp_yolo26s_p2/weights/
runs/sfp_yolo26s_p2/weights/*
!runs/sfp_yolo26s_p2/weights/best.pt

# Referenced by args.yaml above; without it that configuration dangles. Its
# `path:` stays absolute on purpose -- ultralytics resolves a relative dataset
# path against its own DATASETS_DIR, not against this file, so a relative one
# would silently point elsewhere. Regenerate it with `./run.sh yolo`.
!yolo_dataset/data.yaml
