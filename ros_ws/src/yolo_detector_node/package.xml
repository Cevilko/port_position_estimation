<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo_detector_node</name>
  <version>0.0.0</version>
  <description>Runs the trained SFP port detector on live camera topics.</description>
  <maintainer email="sm220315d@student.etf.bg.ac.rs">etfrobotics</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>

  <!-- Deliberately NOT cv_bridge: it is built against NumPy 1.x and segfaults
       under the NumPy 2.x in the venv that carries torch. image_convert.py
       does the unpacking with numpy instead. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
